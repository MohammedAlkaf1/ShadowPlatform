// Shadow Platform (منصة شادو) — Prisma schema
// Multi-tenant disability-support services platform for Saudi universities.
// Every domain model is tenant-scoped so adding tenant #2 later is a seed, not a schema change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserRole {
  student
  faculty
  specialist
  admin
}

// User-facing UI language preference (i18n, next-intl). Saved to the user's
// own profile once they're authenticated — see auth.ts, which syncs this
// from the pre-login NEXT_LOCALE cookie on successful sign-in.
enum Locale {
  ar
  en
}

enum RequestStatus {
  pending
  under_review
  approved
  rejected
}

enum DocumentStatus {
  pending
  reviewed
}

enum SupportPlanStatus {
  draft
  approved
  expired
}

enum AlertSeverity {
  low
  medium
  high
}

enum AlertStatus {
  open
  acknowledged
  resolved
}

// Fixed, hardcoded set of tool codes shared between this platform and the
// Flutter mobile app. NOT admin-editable free text — any new tool requires a
// migration + coordinated app release, on purpose.
enum ToolCode {
  REMINDER_MODE // reminders for tasks/deadlines
  FOCUS_MODE // reduces distractions/notifications in the app
  EXTRA_TIME_TRACKER // tracks/communicates extended-time accommodation for exams/assignments
  SIMPLIFIED_UI // simplified navigation & reduced visual complexity
  TEXT_TO_SPEECH // reads on-screen text aloud
  SPEECH_TO_TEXT // dictation input instead of typing
  VISUAL_SCHEDULE // visual/step-by-step schedule support
  CALM_MODE // grounding/anxiety-reduction tools inside the app
  // Phase 3, pre-approved: top-level mode switches. These gate whether the
  // app's 4 top-level mode cards (deaf/visual/learning/physical) appear at
  // all, a coarser layer than the 8 granular tools above.
  DEAF_MODE
  VISUAL_MODE
  LEARNING_MODE
  PHYSICAL_MODE
}

enum FacultyResourceCategory {
  simplified_content
  visual_adjustment
  extra_exercises
  other
}

// ─────────────────────── Voice-driven exams (Phase 1, MCQ only) ───────────────────────
//
// EXPLICIT, USER-CONFIRMED EXCEPTION to this project's "no AI/chatbot inside
// the platform" rule (see AGENTS.md) — scoped ONLY to AI_GENERATED exam
// question generation (Gemini, server-side, see src/lib/ai.ts) and the TTS
// proxy (/api/tts/generate). This is not license to add AI anywhere else.

enum ExamSource {
  MANUAL
  AI_GENERATED
}

enum QuestionType {
  MCQ
  // Essay/free-response is out of scope this round - this enum exists so
  // adding it later doesn't need a big migration, per explicit product
  // instruction. Do not build any UI/API path for a non-MCQ type now.
}

enum LectureKeytermSource {
  AI_EXTRACTED
  MANUAL
}

enum ExamSubmissionStatus {
  in_progress
  completed
}

// ───────────────────────────── Tenant ─────────────────────────────

model Tenant {
  id                    String   @id @default(uuid())
  name                  String
  nameEn                String
  active                Boolean  @default(true)
  selfSignupEnabled     Boolean  @default(false)
  emailDomain           String?
  documentRetentionDays Int      @default(90)
  createdAt             DateTime @default(now())

  users                 User[]
  studentProfiles       StudentProfile[]
  categories            Category[]
  conditions            Condition[]
  supportLevels         SupportLevel[]
  documents             Document[]
  assessments           Assessment[]
  supportPlans          SupportPlan[]
  usageEvents           UsageEvent[]
  mentorAlerts          MentorAlert[]
  facultyCourseLinks    FacultyCourseLink[]
  auditLogs             AuditLog[]
  specialistAssignments SpecialistAssignment[]
  facultyResources      FacultyResource[]
  exams                 Exam[]
  examSubmissions       ExamSubmission[]
  lectureKeyterms       LectureKeyterm[]

  @@map("tenants")
}

// ───────────────────────────── Users ─────────────────────────────

model User {
  id           String    @id @default(uuid())
  tenantId     String
  email        String
  fullName     String
  passwordHash String
  role         UserRole
  active       Boolean   @default(true)
  locale       Locale    @default(ar)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  studentProfile StudentProfile?

  uploadedDocuments        Document[]             @relation("DocumentUploadedBy")
  assessmentsAsSpecialist  Assessment[]           @relation("AssessmentSpecialist")
  approvedSupportPlans     SupportPlan[]          @relation("SupportPlanApprovedBy")
  planRevisions            PlanRevision[]         @relation("PlanRevisionBy")
  assignedMentorAlerts     MentorAlert[]          @relation("MentorAlertAssignedSpecialist")
  facultyCourseLinks       FacultyCourseLink[]    @relation("FacultyCourseLinkFaculty")
  auditLogsAsActor         AuditLog[]             @relation("AuditLogActor")
  specialistAssignments    SpecialistAssignment[] @relation("SpecialistAssignmentSpecialist")
  assignmentsMade          SpecialistAssignment[] @relation("SpecialistAssignmentAssignedBy")
  uploadedFacultyResources FacultyResource[]      @relation("FacultyResourceUploadedBy")
  examsAsFaculty           Exam[]                 @relation("ExamFaculty")
  examSubmissionsAsStudent ExamSubmission[]       @relation("ExamSubmissionStudent")
  lectureKeytermsAsFaculty LectureKeyterm[]       @relation("LectureKeytermFaculty")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model StudentProfile {
  id            String        @id @default(uuid())
  userId        String        @unique
  tenantId      String
  studentNumber String
  major         String
  academicStage String
  phone         String
  requestStatus RequestStatus @default(pending)
  verified      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  deletedAt     DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  documents             Document[]
  assessments           Assessment[]
  supportPlans          SupportPlan[]
  usageEvents           UsageEvent[]
  mentorAlerts          MentorAlert[]
  facultyCourseLinks    FacultyCourseLink[]
  auditLogTargets       AuditLog[]             @relation("AuditLogTargetStudent")
  specialistAssignments SpecialistAssignment[]
  facultyResources      FacultyResource[]

  @@index([tenantId])
  @@index([tenantId, requestStatus])
  @@map("student_profiles")
}

// Specialist ↔ student assignment. NOT part of the original ERD supplied for
// this build, but added because the spec's central rule — "a specialist
// sees only students assigned/referred to them, and this assignment is
// MANUAL by admin, not automatic" — has no way to be implemented without an
// explicit assignment record. Managed from /admin/users.
model SpecialistAssignment {
  id               String   @id @default(uuid())
  tenantId         String
  specialistUserId String
  studentProfileId String
  assignedByUserId String
  createdAt        DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  specialist     User           @relation("SpecialistAssignmentSpecialist", fields: [specialistUserId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  assignedBy     User           @relation("SpecialistAssignmentAssignedBy", fields: [assignedByUserId], references: [id])

  @@unique([specialistUserId, studentProfileId])
  @@index([tenantId])
  @@index([specialistUserId])
  @@index([studentProfileId])
  @@map("specialist_assignments")
}

// ─────────────────────── Classification taxonomy ───────────────────────

model Category {
  id       String @id @default(uuid())
  tenantId String
  nameAr   String
  nameEn   String
  code     String

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conditions Condition[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("categories")
}

model Condition {
  id         String @id @default(uuid())
  categoryId String
  tenantId   String
  nameAr     String
  nameEn     String

  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessments Assessment[]

  @@index([tenantId])
  @@index([categoryId])
  @@map("conditions")
}

model SupportLevel {
  id       String @id @default(uuid())
  tenantId String
  nameAr   String
  order    Int // 1 = light, 2 = medium, 3 = intensive

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessments   Assessment[]
  planRevisions PlanRevision[]

  @@unique([tenantId, order])
  @@index([tenantId])
  @@map("support_levels")
}

// ───────────────────────────── Documents ─────────────────────────────

model Document {
  id               String         @id @default(uuid())
  tenantId         String
  studentProfileId String
  uploadedByUserId String
  objectKey        String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  encryptionKeyRef String
  status           DocumentStatus @default(pending)
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  uploadedBy     User           @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([tenantId])
  @@index([studentProfileId])
  @@map("documents")
}

// ───────────────────────────── Assessment ─────────────────────────────

model Assessment {
  id               String   @id @default(uuid())
  tenantId         String
  studentProfileId String
  specialistUserId String
  conditionId      String
  supportLevelId   String
  notes            String
  assessedAt       DateTime
  createdAt        DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  specialist     User           @relation("AssessmentSpecialist", fields: [specialistUserId], references: [id])
  condition      Condition      @relation(fields: [conditionId], references: [id])
  supportLevel   SupportLevel   @relation(fields: [supportLevelId], references: [id])

  supportPlans SupportPlan[]

  @@index([tenantId])
  @@index([studentProfileId])
  @@index([specialistUserId])
  @@map("assessments")
}

// ───────────────────────────── Support Plan ─────────────────────────────

model SupportPlan {
  id               String            @id @default(uuid())
  tenantId         String
  studentProfileId String
  assessmentId     String
  approvedByUserId String?
  status           SupportPlanStatus @default(draft)
  approvedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime          @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  assessment     Assessment     @relation(fields: [assessmentId], references: [id])
  approvedBy     User?          @relation("SupportPlanApprovedBy", fields: [approvedByUserId], references: [id])

  toolActivations ToolActivation[]
  planRevisions   PlanRevision[]

  @@index([tenantId])
  @@index([studentProfileId])
  @@map("support_plans")
}

model ToolActivation {
  id            String   @id @default(uuid())
  supportPlanId String
  toolCode      ToolCode
  enabled       Boolean  @default(true)
  config        Json?

  supportPlan SupportPlan @relation(fields: [supportPlanId], references: [id], onDelete: Cascade)

  @@unique([supportPlanId, toolCode])
  @@index([supportPlanId])
  @@map("tool_activations")
}

model PlanRevision {
  id                String   @id @default(uuid())
  supportPlanId     String
  revisedByUserId   String
  newSupportLevelId String
  reason            String
  createdAt         DateTime @default(now())

  supportPlan     SupportPlan  @relation(fields: [supportPlanId], references: [id], onDelete: Cascade)
  revisedBy       User         @relation("PlanRevisionBy", fields: [revisedByUserId], references: [id])
  newSupportLevel SupportLevel @relation(fields: [newSupportLevelId], references: [id])

  @@index([supportPlanId])
  @@map("plan_revisions")
}

// ───────────────────────────── Usage & Alerts ─────────────────────────────

model UsageEvent {
  id               String   @id @default(uuid())
  tenantId         String
  studentProfileId String
  eventType        String
  payload          Json?
  occurredAt       DateTime
  receivedAt       DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  mentorAlerts MentorAlert[]

  @@index([tenantId])
  @@index([studentProfileId])
  @@map("usage_events")
}

model MentorAlert {
  id                      String        @id @default(uuid())
  tenantId                String
  studentProfileId        String
  assignedSpecialistId    String
  triggeredByUsageEventId String?
  alertType               String
  severity                AlertSeverity
  status                  AlertStatus   @default(open)
  message                 String
  createdAt               DateTime      @default(now())

  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentProfile        StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  assignedSpecialist    User           @relation("MentorAlertAssignedSpecialist", fields: [assignedSpecialistId], references: [id])
  triggeredByUsageEvent UsageEvent?    @relation(fields: [triggeredByUsageEventId], references: [id])

  @@index([tenantId])
  @@index([studentProfileId])
  @@index([assignedSpecialistId])
  @@map("mentor_alerts")
}

// ───────────────────────────── Faculty ─────────────────────────────

model FacultyCourseLink {
  id                     String @id @default(uuid())
  tenantId               String
  facultyUserId          String
  studentProfileId       String
  courseCode             String
  approvedAccommodations Json?

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  faculty        User           @relation("FacultyCourseLinkFaculty", fields: [facultyUserId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([facultyUserId, studentProfileId, courseCode])
  @@index([tenantId])
  @@index([facultyUserId])
  @@index([studentProfileId])
  @@map("faculty_course_links")
}

// Per-student custom files a faculty member uploads for one of their own
// students (simplified slides, adjusted-color copies, extra exercises,
// etc.) — decided entirely from the faculty member's own judgment, not from
// anything the system tells them; the system still never surfaces
// category/condition/support level to faculty. Deliberately NOT encrypted
// (explicit user decision, overriding the default Document pattern) — see
// src/lib/s3.ts's faculty-resources/ object-key prefix, kept visually
// distinct from Document's encrypted objects in the bucket.
model FacultyResource {
  id               String                   @id @default(uuid())
  tenantId         String
  uploadedByUserId String
  studentProfileId String
  courseCode       String
  objectKey        String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  title            String
  category         FacultyResourceCategory?
  note             String?
  createdAt        DateTime                 @default(now())
  deletedAt        DateTime?

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy     User           @relation("FacultyResourceUploadedBy", fields: [uploadedByUserId], references: [id])
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentProfileId])
  @@index([uploadedByUserId])
  @@map("faculty_resources")
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id                     String   @id @default(uuid())
  tenantId               String
  actorUserId            String
  targetStudentProfileId String?
  action                 String
  resourceType           String
  resourceId             String?
  ipAddress              String?
  createdAt              DateTime @default(now())

  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor                User            @relation("AuditLogActor", fields: [actorUserId], references: [id])
  targetStudentProfile StudentProfile? @relation("AuditLogTargetStudent", fields: [targetStudentProfileId], references: [id])

  @@index([tenantId])
  @@index([actorUserId])
  @@index([targetStudentProfileId])
  @@map("audit_logs")
}

// ─────────────────── Voice-driven exam-taking (MCQ, Phase 1) ───────────────────
//
// Draft-vs-published semantics for `Exam.availableAt` (decided here, since
// the spec left this open): `availableAt: null` means the exam is a DRAFT —
// invisible to students no matter how many questions it has, this is the
// state a manually-built exam starts in and the state AI-generated
// questions stay in until the faculty member explicitly approves/saves
// them (see /faculty/exams/new — "never auto-publish AI output"). Setting
// `availableAt` to a non-null timestamp is the one explicit "publish"
// action a faculty member takes; a FUTURE timestamp schedules the exam to
// become visible at that moment (supports "opens Monday 9am"), a
// past-or-now timestamp makes it immediately visible. The student-facing
// GET /api/exams/:id/questions and the enrollment check both require
// `availableAt` to be non-null AND <= now — there is no separate
// boolean `published` field, `availableAt` alone carries both facts
// (whether it's published, and when it became/becomes so).

/**
 * See src/lib/ai.ts for the explicit, scoped AI exception this feature relies on.
 */
model Exam {
  id            String     @id @default(uuid())
  tenantId      String
  title         String
  facultyUserId String
  courseCode    String // matches FacultyCourseLink.courseCode - no separate Course entity exists
  source        ExamSource
  availableAt   DateTime? // null = draft; see the semantics note above this model
  // Least-privilege default (false): a student sees NO score for an exam
  // unless the faculty member explicitly opts in — see the toggle on
  // /faculty/exams/new and /faculty/exams/:id, and GET
  // /api/exams/:id/my-result's own gating on this flag.
  showResultsToStudents Boolean   @default(false)
  createdAt     DateTime   @default(now())
  deletedAt     DateTime?

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  faculty     User             @relation("ExamFaculty", fields: [facultyUserId], references: [id])
  questions   Question[]
  submissions ExamSubmission[]

  @@index([tenantId])
  @@index([facultyUserId])
  @@index([tenantId, courseCode])
  @@map("exams")
}

model Question {
  id     String       @id @default(uuid())
  examId String
  text   String
  type   QuestionType @default(MCQ)
  order  Int

  exam    Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  options QuestionOption[]
  answers Answer[]

  @@index([examId])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false) // NEVER returned by the student-facing GET endpoint - see /api/exams/[id]/questions
  order      Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  Answer[] @relation("AnswerSelectedOption")

  @@index([questionId])
  @@map("question_options")
}

model ExamSubmission {
  id            String               @id @default(uuid())
  tenantId      String
  examId        String
  studentUserId String
  status        ExamSubmissionStatus @default(in_progress)
  startedAt     DateTime             @default(now())
  completedAt   DateTime?
  // Percentage 0-100, computed ONCE when status flips to "completed" (see
  // POST /api/exams/:id/answers) and never recalculated afterward — a
  // deliberate design choice (see faculty results-page report) so the
  // results page reads a stable stored value instead of re-scoring on every
  // view, and so a submission's grade can't silently shift if questions
  // are edited later. Null while in_progress (not yet meaningful).
  score         Float?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student User     @relation("ExamSubmissionStudent", fields: [studentUserId], references: [id])
  answers Answer[]

  @@unique([examId, studentUserId])
  @@index([tenantId])
  @@index([examId])
  @@map("exam_submissions")
}

model Answer {
  id                         String   @id @default(uuid())
  examSubmissionId           String
  questionId                 String
  selectedOptionId           String?
  voiceConfirmationObjectKey String? // S3 object key - same "no binary in DB" pattern as Document/FacultyResource
  answeredAt                 DateTime @default(now())

  examSubmission ExamSubmission  @relation(fields: [examSubmissionId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption? @relation("AnswerSelectedOption", fields: [selectedOptionId], references: [id])

  @@unique([examSubmissionId, questionId])
  @@index([examSubmissionId])
  @@map("answers")
}

// ─────────────────── Lecture keyterm glossary (speech-to-text boosting) ───────────────────
//
// One row per term. Scoped by facultyUserId + courseCode directly on the
// row (same pattern as Exam.courseCode) rather than through
// FacultyCourseLink, since FacultyCourseLink is a per-student enrollment
// row and there is no separate "course" or "lecture" entity in this schema
// to hang a course-wide glossary off of instead.
//
// `approved` (default false) is the review gate: AI-extracted terms start
// unapproved and are invisible to students until the faculty member
// reviews/edits the batch and explicitly approves it - same
// "never auto-publish AI output" rule as the exam feature's
// Exam.availableAt draft state, just modeled as a boolean here since a
// keyterm has no scheduling concept. Manually-added terms are approved
// immediately (no review step makes sense for something the faculty member
// typed themselves).
//
// The glossary ACCUMULATES per course across multiple uploads over the
// term (see POST /api/faculty/keyterms/extract's doc comment) - re-uploading
// slides for the same course adds new terms, it never deletes/replaces
// previously-approved ones.
//
// `chapterTitle` is a manual label the faculty member types in once per
// upload (before extraction), purely for grouping/display on the faculty
// review page (/faculty/keyterms shows one collapsible section per distinct
// chapterTitle) - it does NOT change the uniqueness rule or the
// student-facing API. Uniqueness stays course-wide
// (facultyUserId+courseCode+term, unchanged), not per-chapter: if the same
// term legitimately appears in two chapters' slides, it's still one
// glossary entry (whichever chapter it was first approved under keeps the
// label) rather than a duplicate row - GET /api/courses/:courseCode/keyterms
// has always returned (and still returns) one flat deduplicated list, since
// that's the shape Deepgram's keyterm boosting needs regardless of which
// chapter a term came from.
model LectureKeyterm {
  id            String               @id @default(uuid())
  tenantId      String
  facultyUserId String
  courseCode    String // matches FacultyCourseLink.courseCode - no separate Course entity exists
  chapterTitle  String
  term          String
  source        LectureKeytermSource
  approved      Boolean              @default(false)
  createdAt     DateTime             @default(now())
  deletedAt     DateTime?

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  faculty User   @relation("LectureKeytermFaculty", fields: [facultyUserId], references: [id])

  @@unique([facultyUserId, courseCode, term])
  @@index([tenantId])
  @@index([facultyUserId])
  @@index([tenantId, courseCode])
  @@map("lecture_keyterms")
}
