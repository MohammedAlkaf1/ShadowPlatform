# ───────────────────────────────────────────────────────────
# Shadow Platform — environment variables
# Copy this file to .env.local and fill in real values for local dev.
# .env.local is git-ignored and must never be committed.
# ───────────────────────────────────────────────────────────

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://shadow_admin:shadow_dev_pw@localhost:5433/shadow_platform"

# NextAuth.js
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-with-a-random-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# S3-compatible object storage (MinIO for local dev; see docker-compose.yml).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="shadow_minio_admin"
S3_SECRET_ACCESS_KEY="shadow_minio_secret"
S3_BUCKET="shadow-documents"
S3_FORCE_PATH_STYLE="true"

# AES-256-GCM key used to encrypt uploaded documents server-side before they
# are written to S3/MinIO. Acts as a local stand-in for a real KMS. Must be a
# 64-character hex string (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCUMENT_ENCRYPTION_KEY="replace-with-a-64-char-hex-string"

# Maximum accepted upload size for a single document, in bytes. Default 15MB.
MAX_UPLOAD_SIZE_BYTES="15728640"
